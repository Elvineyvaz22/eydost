# ── Supabase (Required) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://ghbyibsmsztcanurozyk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google Maps (Optional - needed for Taxi page only) ────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ── Site URL (Optional - used for SEO canonical URLs) ─────────────────────────
VITE_SITE_URL=https://eydost.com

# ── eSIM bot API (Required for /api/esim-* server routes) ─────────────────────
# These are server-side only (used by api/*.ts Vercel functions). NEVER prefix
# with VITE_ — the key must not be exposed to the browser. Set the same values
# in Vercel Dashboard → Settings → Environment Variables.
ESIM_BOT_API_KEY=
ESIM_BOT_BASE_URL=https://bot.eydost.az
