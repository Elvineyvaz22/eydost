# ── Supabase (Required) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google Maps (Optional - needed for Taxi page only) ────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ── Site URL (Optional - used for SEO canonical URLs) ─────────────────────────
VITE_SITE_URL=https://eydost.com

# ── Taxi Webhook (Serverless function, required for /api/taxi-webhook) ─────────
BSQD_WEBHOOK_TOKEN=
BSQD_WEBHOOK_URL=https://bsqd.me/api/bot/your-bot-id/master/event/recieve_maps
BSQD_BOT_ID=your-bot-id
