{
  "redirects": [
    {
      "source": "/blog",
      "destination": "/en/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/en/blog/:slug",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "eydost.az" }],
      "destination": "https://eydost.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.eydost.az" }],
      "destination": "https://eydost.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.eydost.com" }],
      "destination": "https://eydost.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com https://va.vercel-scripts.com https://vercel.live https://*.vercel-scripts.com https://app.trysoro.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://*.googleapis.com https://maps.gstatic.com https://*.vercel-insights.com https://vitals.vercel-insights.com https://va.vercel-scripts.com https://vercel.live https://bsqd.me https://app.trysoro.com https://*.trysoro.com; frame-src 'self' https://vercel.live; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync-esim-packages",
      "schedule": "0 6 * * *"
    }
  ],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    { "src": "api/**/*.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(en|az|ru|tr|ar|es|zh)/blog", "dest": "/index.html" },
    { "src": "/(en|az|ru|tr|ar|es|zh)/blog/(.*)", "dest": "/index.html" },
    { "src": "/api/taxi-webhook", "dest": "/api/taxi-webhook.ts" },
    { "src": "/api/taxi-session", "dest": "/api/taxi-session.ts" },
    { "src": "/api/taxi-link-data", "dest": "/api/taxi-link-data.ts" },
    { "src": "/api/geo-country", "dest": "/api/geo-country.ts" },
    { "src": "/api/sync-esim-packages", "dest": "/api/sync-esim-packages.ts" },
    { "src": "/api/esim-proxy", "dest": "/api/esim-proxy.ts" },
    { "src": "/api/esim-packages", "dest": "/api/esim-packages.ts" },
    { "src": "/api/admin-sync", "dest": "/api/admin-sync.ts" },
    { "src": "/api/send-outreach-email", "dest": "/api/send-outreach-email.ts" },
    { "src": "/api/agent-login", "dest": "/api/agent-login.ts" },
    { "src": "/api/agent-register", "dest": "/api/agent-register.ts" },
    { "src": "/api/agent-dashboard", "dest": "/api/agent-dashboard.ts" },
    { "src": "/api/agent-create-referral", "dest": "/api/agent-create-referral.ts" },
    { "src": "/api/agent-lead", "dest": "/api/agent-lead.ts" },
    { "src": "/api/agent-conversion", "dest": "/api/agent-conversion.ts" },
    { "src": "/([a-z0-9-]+-esim)/?$", "dest": "/$1/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
