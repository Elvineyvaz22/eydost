# ── EyDost Bot API ─────────────────────────────────────────────────────────────
BOT_API_KEY=your-bot-api-key
BOT_API_URL=https://bot.eydost.az/api/public/packages

# ── CORS (your frontend URL) ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://eydost.az

# ── API Key (protects sensitive endpoints) ────────────────────────────────────
APP_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Web App URL ───────────────────────────────────────────────────────────────
WEBAPP_URL=https://eydost.az
